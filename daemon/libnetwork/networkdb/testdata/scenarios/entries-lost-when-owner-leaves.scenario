         #3:CreateEntry(nw0, aksgwegmu=xcmqbj)
         #3:LeaveNetwork(nw0)
         #0:JoinNetwork(nw1)
         #3:JoinNetwork(nw2)
         #0:LeaveNetwork(nw1)
         #3:CreateEntry(nw2, adv=nawstbcx)
         #3:CreateEntry(nw2, bpsjfhwjtbs=qbfdgppcbejnhhwtsrdu)
         #3:CreateEntry(nw2, lgfvay=nsafz)
